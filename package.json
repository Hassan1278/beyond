{
  "name": "beyond",
  "version": "0.0.0",
  "private": true,
  "description": "Beyond: website and journal app (frontend/web), backend API, AI letter service, shared contracts and Supabase database",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "workspaces": [
    "frontend/*",
    "backend/*",
    "shared",
    "ai"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@beyond/web",
    "dev:api": "npm run dev --workspace=@beyond/api",
    "build:api": "npm run build --workspace=@beyond/api",
    "lint:backend": "npm run lint --workspace=@beyond/shared && npm run lint --workspace=@beyond/api && npm run lint --workspace=@beyond/ai",
    "typecheck:backend": "npm run typecheck --workspace=@beyond/shared && npm run typecheck --workspace=@beyond/api && npm run typecheck --workspace=@beyond/ai",
    "test:backend": "vitest run --project backend --project ai",
    "test:api:smoke": "node tests/api-health-smoke.mjs",
    "test:api:writing": "node tests/api-writing-acceptance.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:web": "npm run build --workspace=@beyond/web",
    "check:deps": "npm ls --all",
    "db:start": "supabase start --exclude realtime,storage-api,imgproxy,studio,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "lint:frontend": "npm run lint --workspace=@beyond/web",
    "typecheck:frontend": "npm run typecheck --workspace=@beyond/web",
    "test:frontend": "vitest run --project frontend",
    "test:design": "node tests/frontend/journal-smoke.mjs",
    "test:palette": "node tests/frontend/contrast.mjs",
    "dev:ai": "npm run dev --workspace=@beyond/ai",
    "build:ai": "npm run build --workspace=@beyond/ai",
    "test:ai": "vitest run --project ai"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "dtrace-provider": false
  }
}
