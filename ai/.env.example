# Beyond AI service. Copy to .env.local for local development; set the same names in the
# Vercel project "beyond-ai". Values here are dummies. Real keys never go in git.

# Required. The backend sends this as "Authorization: Bearer ...". 32-256 of [A-Za-z0-9_-].
# Use the same value as AI_SERVICE_TOKEN in the backend API project.
AI_SERVICE_TOKEN=replace-with-a-long-random-token-0000000000

# Letters and notes. Leave the keys empty and the service reports "not configured";
# sealed letters then wait in the queue until a key is added.
# auto = Anthropic if its key is set, else OpenAI-compatible if its key is set.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Any OpenAI-compatible Chat Completions endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Extra JSON merged into every chat request, e.g. {"reasoning_effort":"low"}.
# OPENAI_EXTRA_BODY=

# Voice transcription (OpenAI-compatible /audio/transcriptions). Defaults to the OpenAI key/base URL.
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=whisper-1
