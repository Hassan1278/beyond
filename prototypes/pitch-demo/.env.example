# Copy to .env.local (gitignored) for live AI letters in `npm run dev`.
# On Vercel / Netlify, set the same name as a project environment variable.
# Without it the demo still runs: every letter falls back to the scripted voices.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# BEYOND_MODEL=claude-opus-5-5
# BEYOND_EFFORT=low
