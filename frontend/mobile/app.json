{
  "expo": {
    "name": "Beyond",
    "slug": "beyond",
    "version": "0.1.0",
    "scheme": "beyond",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hassan1278.beyond"
    },
    "android": {
      "package": "com.hassan1278.beyond"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-splash-screen"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
