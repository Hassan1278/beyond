# All EXPO_PUBLIC_ values are readable by app users.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Replace this sample with your computer's LAN address or deployed API origin.
# Include only the origin; the shared client will append /api paths.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
