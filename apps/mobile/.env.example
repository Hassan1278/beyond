# Public Supabase URL/key only. Never put a secret/admin/provider key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# HTTPS API reachable from the device. 127.0.0.1 is only for local tooling.
EXPO_PUBLIC_API_URL=https://api.example.com
# Supabase Auth must allow the installed app's beyond:// auth/callback redirect.
# Expo Go and development builds may produce different redirect URIs; see setup.
