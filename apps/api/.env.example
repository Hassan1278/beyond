# Writing configuration only. Use a publishable key, never an admin key.
# Local Supabase may use HTTP on a loopback host; remote URLs require HTTPS.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Comma-separated exact canonical browser origins; no trailing slash or wildcard.
# CORS is not authentication. Admin, job and AI configuration is not required.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
