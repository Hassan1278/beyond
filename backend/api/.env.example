# Writing configuration only. Use a publishable key, never an admin key.
# Local Supabase may use HTTP on a loopback host; remote URLs require HTTPS.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Comma-separated exact canonical browser origins; no trailing slash or wildcard.
# CORS is not authentication. Admin, job and AI configuration is not required.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional account cleanup only. Configure and verify its scheduler before enabling.
# Ordinary journal/settings/memory/todo requests never need these credentials.
# ACCOUNT_DELETION_ENABLED=true
# SUPABASE_SECRET_KEY=sb_secret_dummy_account_only
# ACCOUNT_JOB_TRIGGER_SECRET=replace_with_at_least_32_url_safe_characters

# Optional backend reflection workflow. Leave disabled until the independent AI
# owner supplies and verifies the versioned HTTP service. Never put these in clients.
# REFLECTIONS_ENABLED=true
# AI_SERVICE_URL=https://ai.example.com
# AI_SERVICE_TOKEN=replace_with_at_least_32_url_safe_characters
# REFLECTION_JOB_TRIGGER_SECRET=replace_with_a_different_32_character_secret
# SUPABASE_SECRET_KEY=sb_secret_dummy_backend_only
# Schedule POST /api/v1/internal/reflections/process with its trigger bearer.
