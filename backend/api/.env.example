# Writing configuration only. Use a publishable key, never an admin key.
# Local Supabase may use HTTP on a loopback host; remote URLs require HTTPS.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Comma-separated exact canonical browser origins; no trailing slash or wildcard.
# CORS is not authentication.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional account cleanup. Configure and verify its scheduler before enabling.
# ACCOUNT_DELETION_ENABLED=true
# SUPABASE_SECRET_KEY=sb_secret_dummy_backend_only
# ACCOUNT_JOB_TRIGGER_SECRET=replace_with_at_least_32_url_safe_characters

# Letters, Patterns notes and voice go through the independent AI service (ai/).
# Without these, sealing still works and letters wait in the queue.
# AI_SERVICE_URL=http://127.0.0.1:3003
# AI_SERVICE_TOKEN=replace_with_the_same_token_as_the_ai_service_000
# The scheduled letter worker (POST /api/v1/internal/letters/process) also needs
# SUPABASE_SECRET_KEY and its own trigger bearer, different from every other secret.
# LETTER_JOB_TRIGGER_SECRET=replace_with_a_different_32_character_secret
